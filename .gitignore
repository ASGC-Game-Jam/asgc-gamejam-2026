# Visual Studio and IDE files
.vs/
.idea/
.vscode/
*.DotSettings.user

*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
.vsconfig

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Dynamic libraries
*.so
*.dylib
*.dll

# Static libraries
*.lai
*.la
*.a
*.lib

# GameAnalytics third-party prebuilt SDK libraries
!Plugins/GameAnalytics/Source/**/*.lib
!Plugins/GameAnalytics/Source/**/*.a

# Executables and packaged applications
*.exe
*.out
*.app
*.ipa

# Unreal generated directories
Binaries/
DerivedDataCache/
Intermediate/
Saved/

Plugins/*/Binaries/
Plugins/*/Intermediate/

# Temporary files
*.tmp
*.log

# Packaged builds
Builds/
ArchivedBuilds/
StagedBuilds/

# Generated or local plugin content
Plugins/Developer/

# Local platform/editor configuration
Config/steamvr_ue_editor_app.json
Config/SteamVRBindings/
Platforms/HoloLens/Config/HoloLensEngine.ini

# Operating system files
.DS_Store
Thumbs.db
*.pyc
*.code-workspace

# macOS build artifacts
Build/Mac/Resources/Info.Template.plist
Build/Mac/Resources/Sandbox.*.entitlements
Build/Mac/*.PackageVersionCounter

# Project Borealis Git plugin requires its upstream LFS helper on Windows
!Plugins/GitSourceControl/git-lfs.exe
