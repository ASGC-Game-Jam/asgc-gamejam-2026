=== eavesdropping_conversation ===

{Set_Speaker(rh, 5)} {Set_Dialogue(Print_Char_Name(gb) + ", you MUST understand that I cannot just DELAY <b>my</b> work to address <b>your</b> business problems!")}

{Set_Speaker(gb, 6)} {Set_Dialogue("B-but, Mr " + Print_Char_Name(rh) + "---")}

{Set_Speaker(rh, 5)} {Set_Dialogue("That's <b>doctor</b> " + Print_Char_Name(rh) + " to you! And no <b>buts!</b> Now, if you'll excuse me, I must get back to work with my clients.")}

{Set_Speaker(gb, 2)} {Set_Dialogue("Aw... that's not fair... who's going to help me clean dishes?")}

<center>EXIT {Print_Speaker_Name(gb)}</center>

